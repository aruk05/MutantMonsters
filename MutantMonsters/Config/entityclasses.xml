			<property name="MoveSpeedAggro" value="0.9, 1.1"/>
			<property name="HandItem" value="MutantenItem"/>
			<property name="LootDropEntityClass" value="ChikySack"/>
			<property name="LootDropProb" value="1"/>
			<property name="DismemberMultiplierHead" value=".4"/><property name="DismemberMultiplierArms" value=".4"/><property name="DismemberMultiplierLegs" value=".4"/>
			<property name="DeadBodyHitPoints" value="3000"/>
			<effect_group name="Base Effects">
				<passive_effect name="HealthMax" operation="base_set" value="15000"/>
				<passive_effect name="HealthMax" operation="perc_set" value="1"/>
			</effect_group>
			<drop event="Harvest" name="foodRawMeat" count="0" tool_category="Butcher"/>
			<drop event="Harvest" name="foodRawMeat" tag="butcherHarvest" count="30"/> <!-- animalChicken -->
			<drop event="Harvest" name="resourceFeather" tag="butcherHarvest" count="60"/>
			<drop event="Harvest" name="resourceBone" tag="butcherHarvest" count="20"/>
			<drop event="Harvest" name="resourceAnimalFat" tag="butcherHarvest" count="20"/>
			<drop event="Harvest" name="resourceBone" tag="allToolsHarvest" count="5"/>

		</entity_class>

