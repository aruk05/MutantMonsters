<entity_class name="MutantChicken" extends="animalChickenHostile">
			<property name="SizeScale" value="6"/>
			<property name="Tags" value="entity,animal,chicken,hostile,perkAT03,perkAT04,perkAT05,boss,Mutant"/>
			<property name="Prefab" value="@:Entities/Animals/Bird/animalBirdChickenPrefab.prefab"/>
			<property name="ReplaceMaterial0" value="particleeffects/models/materials/p_glass"/>
			<property name="ReplaceMaterial1" value="entities/resources/materials/oreshaleboulder"/>
